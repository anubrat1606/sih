# Copy to .env (gitignored) and fill in real values. Never commit real keys.

# A local Postgres works (createdb satyapramana_dev, then the URL below as
# written). No local Postgres available? Use the team's shared Neon project
# instead (docs/STATUS.md, decided 2026-09-12) -- ask Anubrat for the
# connection string over a private channel and paste it here in full,
# including its ?sslmode=require. Either way, nothing else changes.
DATABASE_URL=postgresql://localhost/satyapramana_dev
SATYAPRAMANA_MIGRATE_ON_START=1

# Origin the frontend runs at, for CORS. Default is the Vite dev server;
# change this if the frontend is served from anywhere else.
SATYAPRAMANA_FRONTEND_ORIGIN=http://localhost:5173

# Sandbox.co.in (developer.sandbox.co.in) -- console: Settings -> API Keys.
# Both must be set for PAN_STATUS / GST_STATUS to go LIVE; unset either and
# they stay on the honest UnconfiguredAdapter (AWAITING_CREDENTIALS).
SATYAPRAMANA_SANDBOX_API_KEY=
SATYAPRAMANA_SANDBOX_API_SECRET=

# Sandbox.co.in issues separate credential pools for test and production --
# a key_live_/secret_live_ pair only works with SANDBOX_ENV=live. Leave unset
# (or "test") for a key_test_/secret_test_ pair. Every call made with
# SANDBOX_ENV=live is real and billed against the account.
SATYAPRAMANA_SANDBOX_ENV=test

# Backs EXPLAIN and Tender Intelligence -- officer-readable prose and
# candidate-requirement proposals, never a determination of any kind. Leave
# both providers unset and these stages stay on the honest Unconfigured
# classes (available: false); every other endpoint works identically either
# way. If both are set, Groq is preferred (see explain/__init__.py).
#
# Groq (console.groq.com/keys) -- free tier, no credit card required.
SATYAPRAMANA_GROQ_API_KEY=
# Optional -- overrides the default model id (satyapramana_store/explain/groq.py).
SATYAPRAMANA_GROQ_MODEL=
#
# Google AI Studio (aistudio.google.com/apikey) -- free tier is capacity-
# constrained (503 "high demand" is common); the paid tier needs a GCP
# billing account with a real prepay balance, not just free trial credits
# (confirmed 2026-09-29: a $300 GCP trial credit did not cover it -- 402
# "prepayment credits depleted").
SATYAPRAMANA_GEMINI_API_KEY=
# Optional -- overrides the default model id (satyapramana_store/explain/gemini.py).
SATYAPRAMANA_GEMINI_MODEL=

# Auth. Sign/verify session tokens -- a long random string, e.g.
# `python3 -c "import secrets; print(secrets.token_urlsafe(48))"`. Leave
# unset and every /auth/* endpoint answers 503 (honestly unavailable, same
# pattern as every other credential here) rather than the app refusing to
# start or signing tokens with a fabricated fallback secret.
SATYAPRAMANA_JWT_SECRET=

# Creates the first ADMIN account at startup if it doesn't already exist --
# only if BOTH are set and SATYAPRAMANA_MIGRATE_ON_START=1. There is no
# self-signup; every account after this first one is created by an admin via
# POST /auth/users. Leave both unset once the first admin exists so this
# doesn't run again.
SATYAPRAMANA_BOOTSTRAP_ADMIN_USERNAME=
SATYAPRAMANA_BOOTSTRAP_ADMIN_PASSWORD=
